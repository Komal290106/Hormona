# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hormona?retryWrites=true&w=majority

# Your Vercel frontend URL — must match exactly (no trailing slash)
# e.g. https://hormona.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Port — Render sets this automatically, leave as-is
PORT=5000
